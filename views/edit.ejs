<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Question</title>
    <link rel ="stylesheet" href="/pubic.css">
</head>

<body>
    <div class="edit-container">
        <h1>Edit Question</h1>

        <form action="/edit/<%= foundQuestion._id %>?_method=PUT" method="POST">

            <input 
                type="text"
                name="title"
                value="<%= foundQuestion.title %>"
            >

            <br><br>

            <input 
                type="text"
                name="difficulty"
                value="<%= foundQuestion.difficulty %>"
            >

            <br><br>

            <input 
                type="text"
                name="topic"
                value="<%= foundQuestion.topic %>"
            >

            <br><br>

            <textarea 
                name="description"
                ><%= foundQuestion.description %>
            </textarea>

            <br><br>

            <h3>Revision Notes</h3>
            <textarea 
                name="notes"
                placeholder="Enter Revision Notes"
                ><%= foundQuestion.notes %>
            </textarea>

            <br><br>

            <select name="RevisionPriority">
                <option 
                    value="Low"
                    <%= foundQuestion.revisionPriority ==="Low" ? "selected" : "" %>>
                    Low Revision
                </option>
                <option 
                    value="Medium"
                    <%= foundQuestion.revisionPriority ==="Medium" ? "selected" : "" %>>
                    Medium Revision
                </option>
                <option 
                    value="High"
                    <%= foundQuestion.revisionPriority ==="High" ? "selected" : "" %>>
                    High Revision
                </option>
            </select>

            <br><br>

            <button type="submit">
                Update Question
            </button>

        </form>
    </div>

</body>
</html>