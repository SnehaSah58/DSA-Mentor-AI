<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Question</title>
</head>

<body>

    <h1>Edit Question</h1>

    <form action="/edit/<%= foundQuestion._id %>?_method=PUT" method="POST">

        <input 
            type="text"
            name="title"
            value="<%= foundQuestion.title %>"
        >

        <br><br>

        <input 
            type="text"
            name="difficulty"
            value="<%= foundQuestion.difficulty %>"
        >

        <br><br>

        <input 
            type="text"
            name="topic"
            value="<%= foundQuestion.topic %>"
        >

        <br><br>

        <textarea 
            name="description"
        ><%= foundQuestion.description %></textarea>

        <br><br>

        <button type="submit">
            Update Question
        </button>

    </form>

</body>
</html>