<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
    content="width=device-width,
    initial-scale=1.0">

    <title>Signup</title>

    <link rel="stylesheet"
    href="/public.css">

</head>

<body class="auth-body">

    <div class="auth-container">

        <h1>Create Account 🚀</h1>

        <form action="/signup"
        method="POST">

            <input
            type="text"

            name="username"

            placeholder="Enter Username"

            required>



            <input
            type="email"

            name="email"

            placeholder="Enter Email"

            required>


            <input
            type="password"

            name="password"

            placeholder="Enter Password"

            required>

            <button type="submit">

                Signup

            </button>

        </form>



        <p>

            Already have account?

            <a href="/login">

                Login

            </a>

        </p>

    </div>

</body>

</html>