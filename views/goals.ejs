<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,
initial-scale=1.0">

<title>

Goals

</title>

<link rel="stylesheet"
href="/public.css">

</head>

<body>



<div class="navbar">

<div class="logo">

DSA Mentor AI 🚀

</div>



<div class="nav-links">

<a href="/dashboard">

Dashboard

</a>



<a href="/questions">

Questions

</a>



<a href="/goals">

Goals

</a>



<a href="/revision">

Revision

</a>



<button
class="logout-btn"

onclick="openLogoutModal()"
>

Logout

</button>

<a
href="/profile"

class="profile-nav-icon"
>

<%= user.avatar %>

</a>

</div>

</div>



<div class="goals-heading">

<h1>

🎯 Goals Tracker

</h1>



<p>

Stay consistent and
complete your topic goals 😎🔥

</p>

</div>


    <div class="goal-form-container">

<form
action="/goals/add"
method="POST"
class="goal-form"
>

<select
name="topic"
required
>

<option value="">

Select Topic

</option>

<option value="Array">

Array

</option>

<option value="Graph">

Graph

</option>

<option value="DP">

DP

</option>

<option value="Stack">

Stack

</option>

<option value="LinkedList">

LinkedList

</option>

<option value="Heap">

Heap

</option>

<option value="String">

String

</option>

<option value="BinarySearch">

BinarySearch

</option>

</select>



<input
type="number"
name="goalDays"
placeholder="Goal Days"
required
>



<button type="submit">

Add Goal 🎯

</button>

</form>

</div>


<h2 class="section-heading">

🔥 Active Goals

</h2>



<div class="goals-container">

<% activeGoals.forEach((goal)=>{ %>



<div class="goal-card">



<h2>

🎯 <%= goal.topic %>

</h2>



<p>

Goal Duration:
<b>

<%= goal.goalDays %>
Days

</b>

</p>



<%

const topicQuestions =
allQuestions.filter((q)=>{

return q.topic ===
goal.topic;

});



let solvedCount = 0;



topicQuestions.forEach((q)=>{

const progress =
progressMap[
q._id.toString()
];



if(
progress &&
progress.solved
){

solvedCount++;

}

});



const totalQuestions =
topicQuestions.length;



const percentage =
totalQuestions === 0

? 0

: Math.floor(

(solvedCount /
totalQuestions) * 100

);



const remainingDays =
Math.ceil(

(new Date(goal.endDate)
- new Date())

/

(1000*60*60*24)

);

%>



<p>

Progress:

<b>

<%= solvedCount %>

/

<%= totalQuestions %>

</b>

</p>



<div class="goal-progress-bar">

<div
class="goal-progress-fill"

style="
width:<%= percentage %>%;
">

</div>

</div>



<br>



<% if(percentage === 100){ %>

<p class="goal-completed">

✅ Goal Completed

</p>

<% } else if(remainingDays > 0){ %>

<p class="goal-pending">

⏳
<%= remainingDays %>
days left

</p>

<% } else { %>

<p class="goal-missed">

❌ Goal Missed

</p>

<% } %>

</div>

<% }) %>

</div>



<h2 class="section-heading">

🏆 Completed Goals

</h2>



<div class="completed-goals-container">

<% completedGoals.forEach((goal)=>{ %>

<div class="completed-goal-card">

<h2>

✅ <%= goal.topic %>

</h2>

</div>

<% }) %>

</div>

<div
id="logoutModal"

class="logout-modal"
>

<div class="logout-modal-content">

<h2>

Are you sure? 😭

</h2>



<p>

Do you really want
to logout?

</p>



<div class="logout-buttons">

<a href="/logout">

<button class="confirm-logout">

Yes Logout

</button>

</a>



<button
class="cancel-logout"

onclick="closeLogoutModal()"
>

Cancel

</button>

</div>

</div>

</div>

<script>

function openLogoutModal(){

document.getElementById(
"logoutModal"
).style.display = "flex";

}



function closeLogoutModal(){

document.getElementById(
"logoutModal"
).style.display = "none";

}

</script>

</body>

</html>