<!DOCTYPE html>
<html>
<head>

<meta charset="UTF-8">
<meta name="viewport"content="width=device-width,initial-scale=1.0">
<title>Questions</title>
<link rel="stylesheet"href="/public.css">

</head>

<button
    class="chatbot-toggle"
    onclick="openChatbot()">
    🤖 AI Mentor
</button>

<div
id="chatbotBox"
class="chatbot-box"
>

<div class="chatbot-header">
🤖 AI DSA Mentor
</div>

<div

id="chatMessages"
class="chat-messages">

</div>

<div class="chat-input-area">
<input
type="text"
id="userMessage"
placeholder="Ask DSA doubts...">

<button onclick="sendMessage()">
Send
</button>

</div>

</div>

<body>

<div class="navbar">
<div class="logo">
DSA Mentor AI 🚀

</div>

<div class="nav-links">

<a href="/dashboard">
Dashboard
</a>

<a href="/mock-interview">
Mock Interview
</a>

<a href="/questions">
Questions
</a>

<a href="/goals">
Goals
</a>

<a href="/revision">
Revision
</a>

<button
class="logout-btn"
onclick="openLogoutModal()">
Logout
</button>

<a
href="/profile"
class="profile-nav-icon"
>
<%= user.avatar %>
</a>

</div>

</div>


<div class="questions-heading">

<h1>
📚  Study DSA
</h1>

<p>
Practice consistently
and track your progress 😎🔥
</p>

</div>

<div class="search-section">

<form
action="/questions/search"
method="GET">

<input
type="text"
name="topic"
placeholder="Search by Topic">

<button type="submit">
Search
</button>
</form>

</div>


<h2 class="topic-title">
📊 Topic Wise Progress
</h2>


<div class="topic-stats">
<% for(let topic in topicStats){ %>
<div class="topic-card">
<h3>
<%= topic %>

</h3>

<button
class="topic-ai-btn"
onclick="generateNotes('<%= topic %>')"
>
AI Notes 😎🔥
</button>

<button

class="roadmap-btn"

onclick="generateRoadmap('<%= topic %>')"
>
🛣️ AI Roadmap
</button>


<p>
<%= topicStats[topic].solved %>/
<%= topicStats[topic].total %>
Solved
</p>

</div>

<% } %>

</div>

<h2 class="all-questions-heading">
📚 All Questions
</h2>

<div class="questions-container">

<% allQuestions.forEach((q)=>{ %>
    <% const progress = progressMap[q.id.toString()];
    %>

<div class="question-card
<% if(
progress && progress.solved
){ %>

solved-card

<% } %>

">

<h2>
<%= q.title %>
</h2>



<p class="
difficulty-badge

<%= q.difficulty.toLowerCase() %>
">

<%= q.difficulty %>

</p>


<p>

📌 Topic:

<b>

<%= q.topic %>

</b>

</p>


<p>

Status:

<% if(
progress &&
progress.solved
){ %>

<span class="solved-text">

Solved ✅

</span>

<% } else { %>

<span class="unsolved-text">

Unsolved ❌

</span>

<% } %>

</p>


<form
action="/toggle/<%= q._id %>?_method=PATCH"
method="POST"
>

<button type="submit">

<% if(
progress &&
progress.solved
){ %>

Mark as Unsolved

<% } else { %>

Mark as Solved

<% } %>

</button>

</form>


<br>


<% if(q.leetcodeLink){ %>

<a
href="<%= q.leetcodeLink %>"
target="_blank"
>

<button>

Solve on LeetCode 🔗

</button>

</a>

<% } %>

<br>

<button

class="ai-hint-btn"

onclick='getHint(

`<%= q.title %>`,

`<%= q.description %>`,

`<%= q.topic %>`

)'

>

💡 AI Hint

</button>

<div class="description-box">

<h3>

📝 Description

</h3>


<p class="question-description">

<%= q.description %>

</p>

</div>


</div>

<% }) %>

</div>

<div
id="logoutModal"

class="logout-modal"
>

<div class="logout-modal-content">

<h2>

Are you sure? 😭

</h2>


<p>

Do you really want
to logout?

</p>



<div class="logout-buttons">

<a href="/logout">

<button class="confirm-logout">

Yes Logout

</button>

</a>



<button
class="cancel-logout"

onclick="closeLogoutModal()"
>

Cancel

</button>

</div>

</div>

</div>

<script>

function openLogoutModal(){

document.getElementById(
"logoutModal"
).style.display = "flex";

}

function closeLogoutModal(){

document.getElementById(
"logoutModal"
).style.display = "none";

}

</script>

<div
id="notesModal"
class="notes-modal">
<div class="notes-content">
<h2>
AI Notes 😎🔥
</h2>

<p id="notesText">
Loading...
</p>

<button

onclick="closeNotes()"

>

Close

</button>

</div>

</div>

<script>

async function generateNotes(topic){

    document.getElementById(
    "notesModal"
    ).style.display = "flex";
    const response =
    await fetch(
        "/ai-notes",

        {
            method:"POST",

            headers:{

                "Content-Type":"application/json"

            },

            body:JSON.stringify({

                topic

            })

        }

    );



    const data =
    await response.json();

    document.getElementById(
    "notesText"
    ).innerText = data.notes;

}


function closeNotes(){

    document.getElementById(
    "notesModal"
    ).style.display = "none";

}

</script>

<div

id="hintModal"

class="notes-modal"

>

<div class="notes-content">

<h2>

💡 AI Hint

</h2>



<p id="hintText">

Loading...

</p>



<button

onclick="closeHint()"

>

Close

</button>

</div>

</div>

<script>

async function getHint(

title,

description,

topic

){

    document.getElementById(
    "hintModal"
    ).style.display = "flex";



    const response =
    await fetch(

        "/ai-hint",

        {

            method:"POST",

            headers:{

                "Content-Type":"application/json"

            },

            body:JSON.stringify({

                title,

                description,

                topic

            })

        }

    );



    const data =
    await response.json();



    document.getElementById(
    "hintText"
    ).innerText = data.hint;

}



function closeHint(){

    document.getElementById(
    "hintModal"
    ).style.display = "none";

}

</script>

<script>

function openChatbot(){

    const box =
    document.getElementById(
    "chatbotBox"
    );



    if(box.style.display==="flex"){

        box.style.display="none";

    }

    else{

        box.style.display="flex";

    }

}



async function sendMessage(){

    const input =
    document.getElementById(
    "userMessage"
    );



    const message =
    input.value;



    if(!message) return;



    const chatMessages =
    document.getElementById(
    "chatMessages"
    );



    chatMessages.innerHTML +=

    `<div class="user-msg">
    ${message}
    </div>`;



    input.value = "";



    const response =
    await fetch(

        "/ai-chat",

        {

            method:"POST",

            headers:{

                "Content-Type":"application/json"

            },

            body:JSON.stringify({

                message

            })

        }

    );



    const data =
    await response.json();



    chatMessages.innerHTML +=

    `<div class="ai-msg">
    ${data.reply}
    </div>`;

}

</script>

<div

id="roadmapModal"

class="notes-modal"

>

<div class="notes-content">

<h2>

🛣️ AI Roadmap

</h2>



<p id="roadmapText">

Loading...

</p>



<button

onclick="closeRoadmap()"

>

Close

</button>

</div>

</div>

<script>

async function generateRoadmap(topic){

    document.getElementById(
    "roadmapModal"
    ).style.display = "flex";



    const response =
    await fetch(

        "/ai-roadmap",

        {

            method:"POST",

            headers:{

                "Content-Type":"application/json"

            },

            body:JSON.stringify({

                topic

            })

        }

    );



    const data =
    await response.json();



    document.getElementById(
    "roadmapText"
    ).innerText = data.roadmap;

}



function closeRoadmap(){

    document.getElementById(
    "roadmapModal"
    ).style.display = "none";

}

</script>

</body>

</html>