<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>All Questions</title>

    <link rel="stylesheet" href="/public.css">

</head>

<body>

    <h1>ALL  DSA  QUESTIONS</h1>

        <h2>
            🔥 Questions Due For Revision
        </h2>

        <% if(dueQuestions.length === 0){ %>
            <p>No Revision Due 😎</p>
        <% } 
        else { %>
            <% dueQuestions.forEach((q)=>{ %>
            <div class="due-card">
                <h3><%= q.title %></h3>
                <p>
                    Revision Date:
                    <%= q.nextRevisionDate.toDateString() %>
                </p>

                <form
                    action="/revision-complete/<%= q._id %>?_method=PUT" method="POST">
                    <button type="submit">
                        Revision Done ✅
                    </button>
                </form>
            </div>
            <% }) %>
        <% } %>

    <div class="dashboard">
        <div class="dashboard-card">
            <h2>Total</h2>
            <h3><%= totalQuestions %></h3>
        </div>

        <div class="dashboard-card">
            <h2>Solved</h2>
            <h3><%= solvedCount %></h3>
        </div>

        <div class="dashboard-card">
            <h2>Unsolved</h2>
            <h3><%= unsolvedCount %></h3>
        </div>

    </div>

    <h3>
        Progress:
        <%= solvedCount %> / <%= totalQuestions %>
    </h3>
    <h2>
        <%= progressPercentage %>% Completed
    </h2>

    <div class="progress-bar">
        <div 
            class="progress-fill"
            style="width: <%= progressPercentage %>%">
        </div>
    </div>

    <br>

    <div class="difficulty-counts">
        <h3>Easy: <%= easyCount %></h3>
        <h3>Medium: <%= mediumCount %></h3>
        <h3>Hard: <%= hardCount %></h3>
    </div>

    <br><br>

    <form action="/questions/search" method="get">
        <input type="text"
        name="topic"
        placeholder="Search by topic">
        <button type="submit"> Search</button>
    </form>

        <br>

        <a href="/questions/sort/priority">
            <button>
                Sort By Priority
            </button>
        </a>

        <br><br>

    <a href="/questions/difficulty/Easy">
        <button>Easy</button>
    </a>

    <a href="/questions/difficulty/Medium">
        <button>Medium</button>
    </a>

    <a href="/questions/difficulty/Hard">
        <button>Hard</button>
    </a>

    <a href="/questions">
        <button>All</button>
    </a>

    <br><br>

    <% allQuestions.forEach((q)=> { %>

        <div class="question-card <%= q.solved ? 'solved-card' : '' %>">

            <h2><%= q.title %></h2>

            <p>
                <strong>Difficulty:</strong>
                <%= q.difficulty %>
            </p>

            <p>
                <strong>Topic:</strong>
                <%= q.topic %>
            </p>

            <P>
                <strong>Status:</strong>
                <% if(q.solved){ %>
                solved
                <% } else { %>
                Unsolved
                <% } %>
            </P>

            <form action="/toggle/<%= q._id %>?_method=PATCH" method="POST">
                <button type="submit">
                <%= q.solved ? "Mark as Unsolved" : "Mark as Solved"%>
                </button>
            </form>

            <p>
                <strong>Description:</strong>
                <%= q.description %>
            </p>

            <p>
                <strong>lastRevised:</strong>
                <%= q.lastRevised.toDateString() %>
            </p>

            <p>
                <strong>nextRevisionDate:</strong>
                <%= q.nextRevisionDate.toDateString() %>
            </p>

            <%
                const today = new Date();
                const revisionDate = new Date(q.nextRevisionDate);
            %>

            <% if(revisionDate <= today){ %>
                <p class="revision-due">
                    Revision Due 🔥
                </p>
            <% } 
            else { %>
                <p class="revision-scheduled">
                    Revision Scheduled ✅
                </p>
            <% } %>
            

            <% if(q.notes && q.notes.trim() !== "") { %>
                <p>
                    <b>Notes:</b>
                    <%= q.notes %>
                </p>
            <% } %>

            <p>
                <b>revisionPriority:</b>
                <span class="priority-<%= q.revisionPriority.toLowerCase() %>">
                    <%= q.revisionPriority %>
                </span>
            </p>

            <form action="/delete/<%= q._id %>?_method=DELETE" method="POST">
                <button type="submit">Delete</button>
            </form>

            <br>

            <a href="/edit/<%= q._id %>">
                <button> Edit </button>
            </a>
        </div>

    <% }) %>

</body>
</html>