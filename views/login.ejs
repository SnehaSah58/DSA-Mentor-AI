<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
    content="width=device-width,
    initial-scale=1.0">

    <title>Login</title>

    <link rel="stylesheet"
    href="/public.css">

</head>

<body class="auth-body">

    <div class="auth-container">

        <h1>Welcome Back 😎</h1>

        <form action="/login"
        method="POST">

            <input
            type="email"

            name="email"

            placeholder="Enter Email"

            required>



            <input
            type="password"

            name="password"

            placeholder="Enter Password"

            required>



            <button type="submit">

                Login

            </button>

        </form>



        <p>

            New user?

            <a href="/signup">

                Signup

            </a>

        </p>

    </div>

</body>

</html>